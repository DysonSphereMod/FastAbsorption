<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>FastAbsorption</AssemblyName>
    <RootNamespace>FastAbsorption</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\Release\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FastAbsorption.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!--
    Point these two properties at your local install before building, e.g.:

      dotnet build -c Release ^
        -p:BepInExCoreDir="<game>\BepInEx\core" ^
        -p:GameManagedDir="<game>\DSPGAME_Data\Managed"

    Typical locations:
      Windows Steam:           C:\Program Files (x86)\Steam\steamapps\common\Dyson Sphere Program\...
      Linux Proton (r2modman): ~/.config/r2modmanPlus-local/DysonSphereProgram/profiles/Default/BepInEx/core

    Both directories must exist: the mod is compiled against the exact BepInEx 5
    and game assemblies it runs with.
  -->
  <PropertyGroup>
    <!-- e.g. <game>\BepInEx\core  (BepInEx 5) -->
    <BepInExCoreDir></BepInExCoreDir>
    <!-- e.g. <game>\DSPGAME_Data\Managed -->
    <GameManagedDir></GameManagedDir>
  </PropertyGroup>

  <Target Name="CheckReferenceDirectories" BeforeTargets="Compile">
    <Error Condition="'$(BepInExCoreDir)' == ''"
           Text="Set BepInExCoreDir to your BepInEx 5 core folder, e.g. dotnet build -p:BepInExCoreDir=&quot;&lt;game&gt;\BepInEx\core&quot;" />
    <Error Condition="'$(GameManagedDir)' == ''"
           Text="Set GameManagedDir to the game's Managed folder, e.g. dotnet build -p:GameManagedDir=&quot;&lt;game&gt;\DSPGAME_Data\Managed&quot;" />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Harmony"><HintPath>$(BepInExCoreDir)\BepInEx.Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
